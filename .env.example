# ==========================================
# FOOD ORDERING PLATFORM & POS - ENVIRONMENT
# ==========================================
# This file serves as a template for production environments.
# DO NOT commit the actual .env file to version control.

# ------------------------------------------
# 1. CORE APPLICATION (Strictly Required)
# ------------------------------------------
# Set to 'production' to enforce strict security checks.
FLASK_ENV=production

# URLs the frontend is hosted on (used for CORS and callbacks).
FRONTEND_URL=http://localhost:3000,http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# The API URL the frontend should point to (baked in during build).
VITE_API_URL=http://localhost:5000

# ------------------------------------------
# 2. SECRETS & ENCRYPTION (Strictly Required)
# ------------------------------------------
SECRET_KEY=replace_this_with_a_long_random_string
JWT_SECRET_KEY=replace_this_with_another_long_random_string
PAYMENT_ENCRYPTION_KEY=replace_this_with_fernet_key

# ------------------------------------------
# 3. DATABASE (Strictly Required)
# ------------------------------------------
MYSQL_ROOT_PASSWORD=super_secure_root_password
MYSQL_DB=food_pos
MYSQL_USER=food_user
MYSQL_PASSWORD=super_secure_db_password

# ------------------------------------------
# 4. EMAIL CONFIGURATION (Optional, but recommended)
# ------------------------------------------
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=your_smtp_password
MAIL_DEFAULT_SENDER=no-reply@example.com
ADMIN_EMAIL=admin@example.com
